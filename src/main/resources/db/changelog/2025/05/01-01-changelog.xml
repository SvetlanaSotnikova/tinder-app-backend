<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1746106820724-2" author="sotni">
        <createTable tableName="verification_token">
            <column name="id" type="BIGINT"/>
            <column name="token" type="VARCHAR(255)"/>
            <column name="user_id" type="BIGINT"/>
            <column name="expiry_date" type="DATETIME"/>
        </createTable>
    </changeSet>
    <changeSet id="1746106820724-3" author="sotni">
        <addColumn tableName="users">
            <column name="enabled" type="BOOLEAN"/>
        </addColumn>
    </changeSet>
    <changeSet id="1746106820724-4" author="sotni">
        <addNotNullConstraint columnName="enabled" tableName="users"/>
    </changeSet>
    <changeSet id="1746106820724-5" author="sotni">
        <addUniqueConstraint columnNames="user_id" constraintName="uc_verificationtoken_user"
                             tableName="verification_token"/>
    </changeSet>
    <changeSet id="1746106820724-6" author="sotni">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="verification_token"
                                 constraintName="FK_VERIFICATIONTOKEN_ON_USER" referencedColumnNames="id"
                                 referencedTableName="users"/>
    </changeSet>
    <changeSet id="1746106820724-1" author="sotni">
        <addNotNullConstraint columnDataType="VARCHAR(255)" columnName="country" tableName="profile" validate="true"/>
    </changeSet>

</databaseChangeLog>